menu "PRIV I2C U8G2 Component"

    config I2C_U8G2_I2C_PORT
        int "I2C Port Number"
        default 0
        help
            I2C controller index (for example 0 for I2C_NUM_0).

    config I2C_U8G2_SCL_GPIO
        int "SCL GPIO Number"
        default 5
        help
            GPIO number for I2C clock.

    config I2C_U8G2_SDA_GPIO
        int "SDA GPIO Number"
        default 4
        help
            GPIO number for I2C data.

    choice I2C_U8G2_PANEL
        prompt "OLED panel"
        default I2C_U8G2_PANEL_SSD1315
        help
            u8g2 controller setup. The 0.96-inch 128x64 panels are
            SSD1306/SSD1315; the 1.3-inch 128x64 panels are SH1106.

        config I2C_U8G2_PANEL_SSD1315
            bool "SSD1306/SSD1315 0.96\" 128x64"
            help
                Use u8g2_Setup_ssd1315_i2c_128x64_noname_f (default).

        config I2C_U8G2_PANEL_SH1106
            bool "SH1106 1.3\" 128x64"
            help
                Use u8g2_Setup_sh1106_i2c_128x64_noname_f.
    endchoice

    config I2C_U8G2_FREQ_HZ
        int "I2C Bus Frequency (Hz)"
        default 400000
        help
            I2C bus speed in Hertz.

    config I2C_U8G2_TIMEOUT_MS
        int "I2C Transaction Timeout (ms)"
        default 1000
        help
            Timeout used for display I2C transactions.

    config I2C_U8G2_DISPLAY_ADDRESS
        hex "Display I2C Address"
        range 0x00 0x7F
        default 0x3C
        help
            7-bit I2C address of the display device.

    config I2C_U8G2_INTERNAL_PULLUP
        bool "Enable internal SDA/SCL pull-ups"
        default y
        help
            Enable internal pull-up resistors for SDA/SCL pins.

endmenu
